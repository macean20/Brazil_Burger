@using BrasilBurger.Helpers
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Brazil Burger</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
        var clientId = Context.Session.GetString("ClientId");
        var clientNom = Context.Session.GetString("ClientNom");
        var panier = Context.Session.GetObjectFromJson<PanierViewModel>("Panier");
        var panierCount = panier?.TotalItems ?? 0;
    }

    <nav class="navbar navbar-expand-lg navbar-custom">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                🍔 Brazil Burger
            </a>

            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">
                        <a class="nav-link"
                        asp-controller="Home"
                        asp-action="Index">
                            Accueil
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                        asp-controller="Catalogue"
                        asp-action="Index">
                            Menu
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                        asp-controller="Commande"
                        asp-action="MesCommandes">
                            Mes commandes
                        </a>
                    </li>

                    <li class="nav-item position-relative">
                        <a class="nav-link"
                        asp-controller="Panier"
                        asp-action="Index">
                            <i class="fas fa-shopping-cart"></i> Panier
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                        asp-controller="Account"
                        asp-action="Login">
                            Connexion
                        </a>
                    </li>

                </ul>
            </div>
        </div>
    </nav>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="footer bg-dark text-white py-5 mt-5">
        <div class="container">
            <div class="row">
                <div class="col-md-4 mb-4">
                    <div class="d-flex align-items-center mb-3">
                        <div class="logo-circle-footer">
                            <i class="bi bi-emoji-smile-fill text-white"></i>
                        </div>
                        <h5 class="ms-2 mb-0">Brazil Burger</h5>
                    </div>
                    <p class="text-muted">Les meilleurs burgers artisanaux de la ville. Fait avec passion depuis 2025.</p>
                </div>

                <div class="col-md-4 mb-4">
                    <h5 class="mb-3">Navigation</h5>
                    <ul class="list-unstyled">
                        <li><a href="/" class="text-muted text-decoration-none">Accueil</a></li>
                        <li><a href="/Catalogue/Menus" class="text-muted text-decoration-none">Menus</a></li>
                        <li><a href="/Catalogue/Burgers" class="text-muted text-decoration-none">Burgers</a></li>
                    </ul>
                </div>

                <div class="col-md-4 mb-4">
                    <h5 class="mb-3">Contact</h5>
                    <p class="text-muted">
                        <i class="bi bi-telephone-fill me-2"></i>+221 77 123 45 67<br>
                        <i class="bi bi-envelope-fill me-2"></i>contact@brasilburger.sn<br>
                        <i class="bi bi-geo-alt-fill me-2"></i>Dakar, Sénégal
                    </p>
                    <div class="social-links">
                        <a href="#" class="text-white me-3"><i class="bi bi-facebook fs-4"></i></a>
                        <a href="#" class="text-white me-3"><i class="bi bi-instagram fs-4"></i></a>
                        <a href="#" class="text-white"><i class="bi bi-twitter fs-4"></i></a>
                    </div>
                </div>
            </div>
            <hr class="bg-secondary">
            <div class="text-center text-muted">
                <p class="mb-0">&copy; 2025 Brazil Burger. Tous droits réservés.</p>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
