@model MenuDto
@{
    ViewData["Title"] = Model.Nom;
}

<div class="container my-5">
    <div class="row">
        <div class="col-lg-6 mb-4">
            <div class="product-detail-image">
                <img src="@(Model.Burger?.ImageUrl ?? "https://images.pexels.com/photos/1639557/pexels-photo-1639557.jpeg")" alt="@Model.Nom" class="img-fluid rounded-3 shadow" />
            </div>
        </div>
        <div class="col-lg-6">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Accueil</a></li>
                    <li class="breadcrumb-item"><a href="/Catalogue">Catalogue</a></li>
                    <li class="breadcrumb-item active">@Model.Nom</li>
                </ol>
            </nav>

            <h1 class="display-5 fw-bold mb-3">@Model.Nom</h1>
            <span class="badge bg-success mb-3">Menu</span>

            @if (!Model.Disponible)
            {
                <span class="badge bg-danger mb-3">Indisponible</span>
            }

            <div class="mb-4">
                <h2 class="display-6 text-orange fw-bold">
                    @Model.PrixTotal.ToString("N0") <small class="text-muted fs-5">FCFA</small>
                </h2>
            </div>

            <div class="mb-4">
                <h5 class="fw-bold mb-3">Composition du menu</h5>
                <div class="card bg-light">
                    <div class="card-body">
                        <ul class="list-unstyled mb-0">
                            @if (Model.Burger != null)
                            {
                                <li class="mb-2">
                                    <i class="bi bi-check-circle-fill text-success me-2"></i>
                                    <strong>@Model.Burger.Nom</strong>
                                </li>
                            }
                            @if (Model.Frite != null)
                            {
                                <li class="mb-2">
                                    <i class="bi bi-check-circle-fill text-success me-2"></i>
                                    <strong>@Model.Frite.Nom</strong>
                                </li>
                            }
                            @if (Model.Boisson != null)
                            {
                                <li class="mb-2">
                                    <i class="bi bi-check-circle-fill text-success me-2"></i>
                                    <strong>@Model.Boisson.Nom</strong>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <div class="mb-4">
                    <h5 class="fw-bold mb-2">Description</h5>
                    <p class="text-muted">@Model.Description</p>
                </div>
            }

            @if (Model.Disponible)
            {
                <form asp-controller="Panier" asp-action="AjouterMenu" method="post" class="mb-4">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label for="quantite" class="form-label">Quantité</label>
                            <input type="number" class="form-control" name="quantite" id="quantite" value="1" min="1" max="10" />
                        </div>
                        <div class="col-md-8 d-flex align-items-end">
                            <button type="submit" class="btn btn-orange w-100 btn-lg">
                                <i class="bi bi-cart-plus me-2"></i>Ajouter au panier
                            </button>
                        </div>
                    </div>
                </form>
            }

            <div class="d-flex gap-2">
                <a href="/Catalogue/Menus" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-2"></i>Retour au catalogue
                </a>
            </div>
        </div>
    </div>
</div>
