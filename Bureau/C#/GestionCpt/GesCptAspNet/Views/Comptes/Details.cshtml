@model GesCptAspNet.Models.CompteDetailsViewModel

@{
    ViewData["Title"] = "Détails du compte";
}

<link rel="stylesheet" href="~/css/details-compte.css" />

<div class="container my-4">

    <!-- Titre + champ recherche -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="page-title">Détails du compte</h2>

        <!-- Bouton Retour (facultatif) -->
        <a asp-controller="Home" asp-action="Index" class="btn btn-light btn-sm">
            ← Retour
        </a>
    </div>

    <form method="get" class="mb-3">
        <div class="input-group search-account">
            <input type="text"
                   name="numeroCompte"
                   class="form-control"
                   placeholder="Saisir le numéro du compte"
                   value="@Model?.NumeroRecherche" />

            <!-- On conserve le filtre courant à chaque recherche -->
            <input type="hidden" name="filtreType" value="@Model?.FiltreType" />
            <input type="hidden" name="page" value="1" />

            <button type="submit" class="btn btn-primary">OK</button>
        </div>
    </form>

    @if (!string.IsNullOrEmpty(Model?.MessageErreur))
    {
        <div class="alert alert-danger">@Model.MessageErreur</div>
    }

    <div class="row">

        <div class="col-md-4">

            @if (Model?.Compte != null)
            {
                <!-- Informations du compte -->
                <div class="card info-card mb-3">
                    <div class="card-body">
                        <h5 class="card-title">Informations du compte</h5>
                        <div class="info-line">
                            <span class="label">N° Compte:</span>
                            <span class="value link">@Model.Compte.NumeroCompte</span>
                        </div>
                        <div class="info-line">
                            <span class="label">Titulaire:</span>
                            <span class="value">@Model.Compte.Titulaire</span>
                        </div>
                        <div class="info-line">
                            <span class="label">Type:</span>
                            <span class="value badge bg-info text-dark">@Model.Compte.TypeCompte</span>
                        </div>
                        <div class="info-line">
                            <span class="label">Solde actuel:</span>
                            <span class="value text-success fw-bold">
                                @String.Format("{0:N0} FCFA", Model.Compte.SoldeActuel)
                            </span>
                        </div>
                        <div class="info-line">
                            <span class="label">Date de création:</span>
                            <span class="value">@Model.Compte.DateCreation.ToShortDateString()</span>
                        </div>
                        <div class="info-line">
                            <span class="label">Statut:</span>
                            <span class="value">
                                <span class="badge bg-warning text-dark">@Model.Compte.Statut</span>
                            </span>
                        </div>
                        @if (Model.Compte.DateDeblocage.HasValue)
                        {
                            <div class="info-line">
                                <span class="label">Date de déblocage:</span>
                                <span class="value">@Model.Compte.DateDeblocage?.ToShortDateString()</span>
                            </div>
                        }
                    </div>
                </div>

                <!-- Statistiques -->
                <div class="card stats-card">
                    <div class="card-body">
                        <h5 class="card-title">Statistiques</h5>
                        <p>
                            <span class="label">Total des dépôts:</span>
                            <span class="value text-success fw-bold">
                                @String.Format("{0:N0} FCFA", Model.Statistiques.TotalDepots)
                            </span>
                        </p>
                        <p>
                            <span class="label">Total des retraits:</span>
                            <span class="value text-danger fw-bold">
                                @String.Format("{0:N0} FCFA", Model.Statistiques.TotalRetraits)
                            </span>
                        </p>
                        <p>
                            <span class="label">Nombre de transactions:</span>
                            <span class="value">@Model.Statistiques.NombreTransactions</span>
                        </p>
                        <p>
                            <span class="label">Dernière transaction:</span>
                            <span class="value">
                                @(Model.Statistiques.DerniereTransaction?.ToShortDateString() ?? "-")
                            </span>
                        </p>
                    </div>
                </div>
            }
        </div>

        <!-- Colonne droite : Historique global (toujours affiché) -->
        <div class="col-md-8">
            <div class="card history-card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h5 class="card-title mb-0">Historique des transactions</h5>

                        <!-- Filtre par type -->
                        <form method="get" class="d-flex align-items-center gap-2">
                            <input type="hidden" name="numeroCompte" value="@Model?.NumeroRecherche" />
                            <input type="hidden" name="page" value="1" />

                            <label class="me-1 small text-muted">Type :</label>
                            <select name="filtreType" class="form-select form-select-sm" onchange="this.form.submit()">
                                <option value="" selected="@(string.IsNullOrEmpty(Model?.FiltreType))">Tous</option>
                                <option value="Dépôt" selected="@(Model?.FiltreType == "Dépôt")">Dépôt</option>
                                <option value="Retrait" selected="@(Model?.FiltreType == "Retrait")">Retrait</option>
                            </select>
                        </form>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Date</th>
                                    <th>Type</th>
                                    <th>Montant</th>
                                    <th>Solde après</th>
                                    <th>Description</th>
                                    <th>Compte</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var t in Model.Transactions)
                                {
                                    bool isDepot = t.TypeTransaction == "Dépôt";
                                    string signe = isDepot ? "+" : "-";
                                    string classeMontant = isDepot ? "text-success" : "text-danger";
                                    string badgeClass = isDepot ? "badge-depot" : "badge-retrait";

                                    <tr>
                                        <td>@t.IdTransaction</td>
                                        <td>@t.DateTransaction.ToShortDateString()</td>
                                        <td>
                                            <span class="badge @badgeClass">@t.TypeTransaction</span>
                                        </td>
                                        <td class="@classeMontant fw-bold">
                                            @signe @String.Format("{0:N0} FCFA", t.Montant)
                                        </td>
                                        <td>@String.Format("{0:N0} FCFA", t.SoldeApres)</td>
                                        <td>@t.Description</td>
                                        <td>@t.Compte.NumeroCompte</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <nav aria-label="Pagination" class="mt-3">
                        <ul class="pagination pagination-sm justify-content-end mb-0">
                            <li class="page-item @(Model.PageCourante <= 1 ? "disabled" : "")">
                                <a class="page-link"
                                   href="@Url.Action("Details", new { page = Model.PageCourante - 1, filtreType = Model.FiltreType, numeroCompte = Model.NumeroRecherche })">
                                    Précédent
                                </a>
                            </li>

                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.PageCourante ? "active" : "")">
                                    <a class="page-link"
                                       href="@Url.Action("Details", new { page = i, filtreType = Model.FiltreType, numeroCompte = Model.NumeroRecherche })">
                                        @i
                                    </a>
                                </li>
                            }

                            <li class="page-item @(Model.PageCourante >= Model.TotalPages ? "disabled" : "")">
                                <a class="page-link"
                                   href="@Url.Action("Details", new { page = Model.PageCourante + 1, filtreType = Model.FiltreType, numeroCompte = Model.NumeroRecherche })">
                                    Suivant
                                </a>
                            </li>
                        </ul>
                    </nav>

                </div>
            </div>
        </div>
    </div>
</div>
