@model PaiementViewModel
@{
    ViewData["Title"] = "Paiement";
}

<section class="commande-header">
    <div class="container py-4">
        <h1 class="h3 fw-bold text-white mb-0">Commande</h1>
        <p class="text-white-50 mb-0">Choisissez votre mode de réception</p>
    </div>
</section>

<div class="container my-5">
    <form asp-controller="Paiement" asp-action="Process" method="post">
        <input type="hidden" asp-for="CommandeId" />
        <input type="hidden" asp-for="NumeroCommande" />
        <input type="hidden" asp-for="MontantTotal" />
        <input type="hidden" asp-for="SousTotal" />
        <input type="hidden" asp-for="FraisLivraison" />

        <div class="row">
            <div class="col-lg-8">
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">Mode de paiement</h5>
                    </div>
                    <div class="card-body">
                        <div class="payment-option mb-3">
                            <input type="radio" class="btn-check" name="ModePaiement" id="wave" value="WAVE" required />
                            <label class="btn btn-outline-warning w-100 text-start p-4" for="wave">
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-phone fs-2 me-3"></i>
                                    <div>
                                        <strong class="d-block">Wave</strong>
                                        <small class="text-muted">Paiement mobile rapide et sécurisé</small>
                                    </div>
                                </div>
                            </label>
                        </div>

                        <div class="payment-option mb-3">
                            <input type="radio" class="btn-check" name="ModePaiement" id="om" value="OM" />
                            <label class="btn btn-outline-warning w-100 text-start p-4" for="om">
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-phone fs-2 me-3"></i>
                                    <div>
                                        <strong class="d-block">Orange Money</strong>
                                        <small class="text-muted">Paiement mobile rapide et sécurisé</small>
                                    </div>
                                </div>
                            </label>
                        </div>

                        <div class="payment-option">
                            <input type="radio" class="btn-check" name="ModePaiement" id="especes" value="ESPECES" />
                            <label class="btn btn-outline-success w-100 text-start p-4" for="especes">
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-cash-stack fs-2 me-3"></i>
                                    <div>
                                        <strong class="d-block">Espèces</strong>
                                        <small class="text-muted">Paiement à la livraison ou sur place</small>
                                    </div>
                                </div>
                            </label>
                        </div>

                        <span asp-validation-for="ModePaiement" class="text-danger small"></span>
                    </div>
                </div>

                <div class="card shadow-sm mb-4" id="numeroTelephoneCard" style="display: none;">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">Numéro de téléphone</h5>
                    </div>
                    <div class="card-body">
                        <label id="numeroLabel" class="form-label"></label>
                        <input asp-for="NumeroTelephone" class="form-control" placeholder="+221 78 833 25 13" />
                        <span asp-validation-for="NumeroTelephone" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card shadow-sm">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">Récapitulatif de la commande</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <small class="text-muted">Numéro de commande</small>
                            <h6 class="fw-bold">@Model.NumeroCommande</h6>
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between mb-2">
                            <span>Sous-total</span>
                            <strong>@Model.SousTotal.ToString("N0") FCFA</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span>Frais de livraison</span>
                            <strong>@Model.FraisLivraison.ToString("N0") FCFA</strong>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between mb-4">
                            <strong>Montant total</strong>
                            <h4 class="text-orange fw-bold mb-0">@Model.MontantTotal.ToString("N0")<br/><small>FCFA</small></h4>
                        </div>

                        <button type="submit" class="btn btn-orange w-100 py-3 mb-2">
                            Payer maintenant
                            <i class="bi bi-arrow-right ms-2"></i>
                        </button>

                        <a href="/Commande/Checkout" class="btn btn-outline-secondary w-100">
                            <i class="bi bi-arrow-left me-2"></i>Retour
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const numeroCard = document.getElementById('numeroTelephoneCard');
            const numeroLabel = document.getElementById('numeroLabel');

            document.querySelectorAll('input[name="ModePaiement"]').forEach(radio => {
                radio.addEventListener('change', function() {
                    if (this.value === 'WAVE' || this.value === 'OM') {
                        numeroCard.style.display = 'block';
                        numeroLabel.textContent = this.value === 'WAVE' ? 'Numéro Wave *' : 'Numéro Orange Money *';
                    } else {
                        numeroCard.style.display = 'none';
                    }
                });
            });
        });
    </script>
}
