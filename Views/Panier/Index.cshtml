@model PanierViewModel
@{
    ViewData["Title"] = "Panier";
}

<div class="container my-5">
    <div class="row">
        <div class="col-md-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="fw-bold mb-0">
                    <i class="bi bi-cart3 me-2"></i>Panier
                </h2>
                <span class="text-muted">@Model.TotalItems article(s)</span>
            </div>
        </div>
    </div>

    @if (Model.Items.Any())
    {
        <div class="row">
            <div class="col-lg-8">
                <div class="card shadow-sm mb-4">
                    <div class="card-body">
                        @foreach (var item in Model.Items)
                        {
                            <div class="panier-item">
                                <div class="row align-items-center">
                                    <div class="col-md-2">
                                        <img src="@(item.ImageUrl ?? "https://images.pexels.com/photos/1639557/pexels-photo-1639557.jpeg")" alt="@item.Nom" class="img-fluid rounded" />
                                    </div>
                                    <div class="col-md-4">
                                        <h5 class="mb-1">@item.Nom</h5>
                                        <p class="text-muted small mb-0">@item.Prix.ToString("N0") FCFA x @item.Quantite</p>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="input-group input-group-sm">
                                            <form asp-action="UpdateQuantite" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <input type="hidden" name="type" value="@item.Type" />
                                                <input type="hidden" name="quantite" value="@(item.Quantite - 1)" />
                                                <button class="btn btn-outline-secondary" type="submit">
                                                    <i class="bi bi-dash"></i>
                                                </button>
                                            </form>
                                            <input type="text" class="form-control text-center" value="@item.Quantite" readonly />
                                            <form asp-action="UpdateQuantite" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <input type="hidden" name="type" value="@item.Type" />
                                                <input type="hidden" name="quantite" value="@(item.Quantite + 1)" />
                                                <button class="btn btn-outline-secondary" type="submit">
                                                    <i class="bi bi-plus"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                    <div class="col-md-2 text-end">
                                        <h5 class="mb-0 fw-bold">@item.SousTotal.ToString("N0")<br/><small class="text-muted">FCFA</small></h5>
                                    </div>
                                    <div class="col-md-1 text-end">
                                        <form asp-action="Supprimer" method="post">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <input type="hidden" name="type" value="@item.Type" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="d-flex gap-3">
                    <a href="/Catalogue" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-2"></i>Continuer les achats
                    </a>
                    <form asp-action="Vider" method="post" class="d-inline">
                        <button type="submit" class="btn btn-outline-danger">
                            <i class="bi bi-trash me-2"></i>Vider le panier
                        </button>
                    </form>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card shadow-sm">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">Résumé</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-3">
                            <span>Sous-total</span>
                            <strong>@Model.SousTotal.ToString("N0") FCFA</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span>Frais de livraison</span>
                            <strong>@Model.FraisLivraison.ToString("N0") FCFA</strong>
                        </div>
                        @if (Model.FraisLivraison == 0)
                        {
                            <p class="text-success small mb-3">
                                <i class="bi bi-info-circle me-1"></i>
                                Plus que 200 FCFA pour la livraison gratuite
                            </p>
                        }
                        <hr />
                        <div class="d-flex justify-content-between mb-4">
                            <strong>Total</strong>
                            <h4 class="text-orange fw-bold mb-0">@Model.Total.ToString("N0") FCFA</h4>
                        </div>

                        <a href="/Commande/Checkout" class="btn btn-orange w-100 py-3 mb-3">
                            Continuer vers le paiement
                            <i class="bi bi-arrow-right ms-2"></i>
                        </a>

                        <div class="payment-methods text-center">
                            <p class="text-muted small mb-2">Moyens de paiement acceptés</p>
                            <div class="d-flex justify-content-center gap-2">
                                <span class="badge bg-warning text-dark">Wave</span>
                                <span class="badge bg-warning text-dark">Orange Money</span>
                                <span class="badge bg-success">Espèces</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-cart-x display-1 text-muted"></i>
            <h3 class="mt-4 mb-3">Votre panier est vide</h3>
            <p class="text-muted mb-4">Explorez notre menu et ajoutez des produits à votre panier</p>
            <a href="/Catalogue" class="btn btn-orange btn-lg">
                <i class="bi bi-arrow-left me-2"></i>Voir le menu
            </a>
        </div>
    }
</div>
