@model RegisterViewModel
@{
    ViewData["Title"] = "Créer un compte";
    Layout = null;
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Brazil Burger</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="auth-bg">
    <div class="container">
        <div class="row justify-content-center align-items-center min-vh-100 py-5">
            <div class="col-md-5">
                <div class="auth-card">
                    <div class="text-center mb-4">
                        <div class="logo-circle-large mx-auto mb-3">
                            <i class="bi bi-emoji-smile-fill text-white fs-1"></i>
                        </div>
                        <h2 class="fw-bold mb-2">Créer un compte</h2>
                        <p class="text-muted">Rejoignez Brazil Burger et profitez d'avantages exclusifs</p>
                    </div>

                    <form asp-action="Register" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label asp-for="NomComplet" class="form-label">Nom complet</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">
                                    <i class="bi bi-person text-muted"></i>
                                </span>
                                <input asp-for="NomComplet" class="form-control border-start-0 ps-0" placeholder="nom" />
                            </div>
                            <span asp-validation-for="NomComplet" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Email</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">
                                    <i class="bi bi-envelope text-muted"></i>
                                </span>
                                <input asp-for="Email" class="form-control border-start-0 ps-0" placeholder="votre@email.com" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Telephone" class="form-label">Téléphone</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">
                                    <i class="bi bi-telephone text-muted"></i>
                                </span>
                                <input asp-for="Telephone" class="form-control border-start-0 ps-0" placeholder="+221 77 123 45 67" />
                            </div>
                            <span asp-validation-for="Telephone" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">Mot de passe</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">
                                    <i class="bi bi-lock text-muted"></i>
                                </span>
                                <input asp-for="Password" type="password" class="form-control border-start-0 ps-0" placeholder="••••••••" />
                                <button class="btn btn-outline-secondary border-start-0" type="button" onclick="togglePassword('Password')">
                                    <i class="bi bi-eye" id="toggleIconPassword"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="form-label">Confirmer le mot de passe</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">
                                    <i class="bi bi-lock text-muted"></i>
                                </span>
                                <input asp-for="ConfirmPassword" type="password" class="form-control border-start-0 ps-0" placeholder="••••••••" />
                                <button class="btn btn-outline-secondary border-start-0" type="button" onclick="togglePassword('ConfirmPassword')">
                                    <i class="bi bi-eye" id="toggleIconConfirm"></i>
                                </button>
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" required id="acceptTerms" />
                                <label class="form-check-label small" for="acceptTerms">
                                    J'accepte les <a href="#" class="text-danger text-decoration-none">conditions d'utilisation</a>
                                    et la <a href="#" class="text-danger text-decoration-none">politique de confidentialité</a>
                                </label>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-orange w-100 py-3 fw-bold mb-3">
                            Créer mon compte
                        </button>

                        <div class="text-center">
                            <p class="text-muted mb-2">Ou</p>
                            <p class="mb-0">
                                Vous avez déjà un compte ?
                                <a asp-action="Login" class="text-danger text-decoration-none fw-bold">Se connecter</a>
                            </p>
                        </div>
                    </form>

                    <div class="text-center mt-4">
                        <a href="/" class="text-muted text-decoration-none small">Continuer sans compte</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
    <script>
        function togglePassword(fieldName) {
            const passwordInput = document.querySelector(`input[name="${fieldName}"]`);
            const toggleIcon = document.getElementById(fieldName === 'Password' ? 'toggleIconPassword' : 'toggleIconConfirm');

            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                toggleIcon.classList.remove('bi-eye');
                toggleIcon.classList.add('bi-eye-slash');
            } else {
                passwordInput.type = 'password';
                toggleIcon.classList.remove('bi-eye-slash');
                toggleIcon.classList.add('bi-eye');
            }
        }
    </script>
</body>
</html>
