@model CommandeDto
@{
    ViewData["Title"] = "Confirmation";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm text-center p-5">
                <div class="mb-4">
                    <div class="mx-auto mb-3" style="width: 100px; height: 100px; background: linear-gradient(135deg, #4CAF50 0%, #8BC34A 100%); border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                        <i class="bi bi-check-circle-fill text-white" style="font-size: 4rem;"></i>
                    </div>
                    <h2 class="fw-bold mb-2">Paiement réussi !</h2>
                    <p class="text-muted">Votre commande a été confirmée avec succès</p>
                </div>

                <div class="card bg-light mb-4">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-6 text-start">
                                <p class="text-muted mb-1">Numéro de commande</p>
                                <h5 class="fw-bold">@Model.NumeroCommande</h5>
                            </div>
                            <div class="col-6 text-end">
                                <p class="text-muted mb-1">Montant payé</p>
                                <h4 class="text-orange fw-bold mb-0">@Model.MontantTotal.ToString("N0") FCFA</h4>
                            </div>
                        </div>
                    </div>
                </div>

                @if (Model.Paiement != null)
                {
                    <div class="mb-4">
                        <p class="text-muted mb-1">Méthode de paiement</p>
                        <h5 class="fw-bold">@Model.Paiement.ModePaiement</h5>
                    </div>
                }

                <div class="d-flex gap-3 justify-content-center">
                    <a href="/Commande/MesCommandes" class="btn btn-orange btn-lg px-5">
                        <i class="bi bi-bag-check me-2"></i>Mes commandes
                    </a>
                    <a href="/Catalogue" class="btn btn-outline-secondary btn-lg px-5">
                        <i class="bi bi-house me-2"></i>Retour à l'accueil
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
