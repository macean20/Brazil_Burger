{# templates/gestionnaire/commande/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Gestion des Commandes - Brasil Burger{% endblock %}

{% block body %}
<div id="dashboardPage">
    <!-- Header -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top shadow-sm">
        <div class="container-fluid">
            <div class="d-flex align-items-center">
                <div class="logo-circle-sm me-3">
                    <i class="bi bi-shop text-white"></i>
                </div>
                <div>
                    <h5 class="mb-0 fw-bold">Brasil Burger</h5>
                    <small class="text-muted">Gestion des Commandes</small>
                </div>
            </div>
            
            <div class="d-flex align-items-center">
                <div class="me-3 text-end d-none d-md-block">
                    <small class="fw-semibold">Gestionnaire</small><br>
                    <small class="text-muted">{{ app.user.email }}</small>
                </div>
                <a href="{{ path('app_logout') }}" class="btn btn-outline-danger">
                    <i class="bi bi-box-arrow-right"></i> Déconnexion
                </a>
            </div>
        </div>
    </nav>

    <!-- Navigation par onglets -->
    <div class="container-fluid mt-4">
        <ul class="nav nav-tabs" id="mainTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <a href="{{ path('gestionnaire_dashboard') }}" class="nav-link">
                    <i class="bi bi-speedometer2"></i> Tableau de bord
                </a>
            </li>
            <li class="nav-item" role="presentation">
                <a href="{{ path('gestionnaire_burger_index') }}" class="nav-link">
                    <i class="bi bi-bag"></i> Burgers
                </a>
            </li>
            <li class="nav-item" role="presentation">
                <a href="{{ path('gestionnaire_menu_index') }}" class="nav-link">
                    <i class="bi bi-menu-button-wide"></i> Menus
                </a>
            </li>
            <li class="nav-item" role="presentation">
                <a href="{{ path('gestionnaire_complement_index') }}" class="nav-link">
                    <i class="bi bi-cup-straw"></i> Compléments
                </a>
            </li>
            <li class="nav-item" role="presentation">
                <a href="{{ path('gestionnaire_commande_index') }}" class="nav-link active">
                    <i class="bi bi-cart"></i> Commandes
                </a>
            </li>
            <li class="nav-item" role="presentation">
                <a href="{{ path('gestionnaire_zone_index') }}" class="nav-link">
                    <i class="bi bi-truck"></i> Livraisons
                </a>
            </li>
        </ul>

        <!-- Contenu -->
        <div class="p-4">
            <h2 class="mb-4">Gestion des Commandes</h2>

            <!-- Filtres -->
            <div class="card mb-4">
                <div class="card-body">
                    {{ form_start(form, {'attr': {'class': 'row g-3'}}) }}
                        <div class="col-md-3">
                            {{ form_row(form.search, {'attr': {'class': 'form-control', 'placeholder': 'Rechercher...'}}) }}
                        </div>
                        <div class="col-md-2">
                            {{ form_row(form.etat, {'attr': {'class': 'form-select'}}) }}
                        </div>
                        <div class="col-md-2">
                            {{ form_row(form.date, {'attr': {'class': 'form-control'}}) }}
                        </div>
                        <div class="col-md-3">
                            {{ form_row(form.client, {'attr': {'class': 'form-select'}}) }}
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="bi bi-filter"></i> Filtrer
                            </button>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>

            <!-- Tableau des commandes -->
            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>N° Commande</th>
                                    <th>Client</th>
                                    <th>Type</th>
                                    <th>Statut</th>
                                    <th>Montant</th>
                                    <th>Date</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for commande in commandes %}
                                <tr>
                                    <td>
                                        <strong>{{ commande.numeroCommande }}</strong>
                                    </td>
                                    <td>
                                        {{ commande.client }}
                                        <br>
                                        <small class="text-muted">{{ commande.client.telephone }}</small>
                                    </td>
                                    <td>
                                        {% if commande.zone %}
                                            <span class="badge bg-info">Livraison</span>
                                        {% else %}
                                            <span class="badge bg-secondary">Sur place</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <span class="badge status-{{ commande.etat|lower|replace({'_': '-'}) }}">
                                            {{ commande.etatLabel }}
                                        </span>
                                    </td>
                                    <td>
                                        <strong>{{ commande.montantTotal|number_format(0, '.', ' ') ~ ' XOF' }}</strong>
                                    </td>
                                    <td>
                                        {{ commande.dateCommande|date('d/m/Y H:i') }}
                                    </td>
                                    <td>
                                        <div class="action-icons">
                                            <!-- Voir les détails -->
                                            <button type="button" 
                                                    class="btn btn-sm btn-outline-info" 
                                                    data-bs-toggle="modal" 
                                                    data-bs-target="#commandeModal{{ commande.id }}"
                                                    title="Détails">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                            
                                            <!-- Actions selon l'état -->
                                            {% if commande.etat == 'EN_ATTENTE' %}
                                                <form method="post" 
                                                      action="{{ path('gestionnaire_commande_changer_statut', {'id': commande.id, 'nouvelEtat': 'VALIDEE'}) }}"
                                                      class="d-inline">
                                                    <button type="submit" 
                                                            class="btn btn-sm btn-success"
                                                            title="Valider la commande">
                                                        <i class="bi bi-check-circle"></i>
                                                    </button>
                                                </form>
                                            {% endif %}
                                            
                                            {% if commande.etat == 'VALIDEE' %}
                                                <form method="post" 
                                                      action="{{ path('gestionnaire_commande_changer_statut', {'id': commande.id, 'nouvelEtat': 'EN_PREPARATION'}) }}"
                                                      class="d-inline">
                                                    <button type="submit" 
                                                            class="btn btn-sm btn-warning"
                                                            title="Commencer la préparation">
                                                        <i class="bi bi-clock"></i>
                                                    </button>
                                                </form>
                                            {% endif %}
                                            
                                            {% if commande.etat == 'EN_PREPARATION' %}
                                                <form method="post" 
                                                      action="{{ path('gestionnaire_commande_changer_statut', {'id': commande.id, 'nouvelEtat': 'TERMINEE'}) }}"
                                                      class="d-inline">
                                                    <button type="submit" 
                                                            class="btn btn-sm btn-primary"
                                                            title="Terminer la commande">
                                                        <i class="bi bi-check"></i>
                                                    </button>
                                                </form>
                                            {% endif %}
                                            
                                            {% if commande.etat == 'TERMINEE' and commande.zone %}
                                                <!-- Bouton pour affecter un livreur -->
                                                <button type="button" 
                                                        class="btn btn-sm btn-info" 
                                                        data-bs-toggle="modal" 
                                                        data-bs-target="#livreurModal{{ commande.id }}"
                                                        title="Affecter un livreur">
                                                    <i class="bi bi-truck"></i>
                                                </button>
                                            {% endif %}
                                            
                                            {% if commande.canBeCanceled() %}
                                                <form method="post" 
                                                      action="{{ path('gestionnaire_commande_annuler', {'id': commande.id}) }}"
                                                      class="d-inline"
                                                      onsubmit="return confirm('Êtes-vous sûr de vouloir annuler cette commande ?');">
                                                    <button type="submit" 
                                                            class="btn btn-sm btn-outline-danger"
                                                            title="Annuler la commande">
                                                        <i class="bi bi-x-circle"></i>
                                                    </button>
                                                </form>
                                            {% endif %}
                                        </div>
                                    </td>
                                </tr>
                                
                                <!-- Modal pour les détails de la commande -->
                                <div class="modal fade" id="commandeModal{{ commande.id }}" tabindex="-1">
                                    <div class="modal-dialog modal-lg">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title">Détails de la commande {{ commande.numeroCommande }}</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body">
                                                <div class="row">
                                                    <div class="col-md-6">
                                                        <h6>Informations client</h6>
                                                        <p>
                                                            <strong>Nom:</strong> {{ commande.client }}<br>
                                                            <strong>Téléphone:</strong> {{ commande.client.telephone }}<br>
                                                            <strong>Email:</strong> {{ commande.client.email }}
                                                        </p>
                                                        
                                                        <h6 class="mt-3">Informations livraison</h6>
                                                        <p>
                                                            <strong>Adresse:</strong> {{ commande.adresseLivraison }}<br>
                                                            {% if commande.zone %}
                                                                <strong>Zone:</strong> {{ commande.zone.nom }}<br>
                                                                <strong>Prix livraison:</strong> {{ commande.zone.prixLivraison|number_format(0, '.', ' ') ~ ' XOF' }}
                                                            {% endif %}
                                                            {% if commande.livreur %}
                                                                <strong>Livreur:</strong> {{ commande.livreur }}<br>
                                                                <strong>Téléphone livreur:</strong> {{ commande.livreur.telephone }}
                                                            {% endif %}
                                                        </p>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <h6>Détails de la commande</h6>
                                                        <table class="table table-sm">
                                                            <thead>
                                                                <tr>
                                                                    <th>Produit</th>
                                                                    <th>Quantité</th>
                                                                    <th>Prix</th>
                                                                    <th>Total</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                {% for ligne in commande.ligneCommandes %}
                                                                <tr>
                                                                    <td>{{ ligne.nomProduit }}</td>
                                                                    <td>{{ ligne.quantite }}</td>
                                                                    <td>{{ ligne.prixUnitaire|number_format(0, '.', ' ') ~ ' XOF' }}</td>
                                                                    <td>{{ ligne.sousTotal|number_format(0, '.', ' ') ~ ' XOF' }}</td>
                                                                </tr>
                                                                {% endfor %}
                                                                {% if commande.zone %}
                                                                <tr>
                                                                    <td colspan="3"><strong>Livraison</strong></td>
                                                                    <td>{{ commande.zone.prixLivraison|number_format(0, '.', ' ') ~ ' XOF' }}</td>
                                                                </tr>
                                                                {% endif %}
                                                                <tr class="table-primary">
                                                                    <td colspan="3"><strong>TOTAL</strong></td>
                                                                    <td><strong>{{ commande.montantTotal|number_format(0, '.', ' ') ~ ' XOF' }}</strong></td>
                                                                </tr>
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- Modal pour affecter un livreur -->
                                {% if commande.etat == 'TERMINEE' and commande.zone %}
                                <div class="modal fade" id="livreurModal{{ commande.id }}" tabindex="-1">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title">Affecter un livreur</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body">
                                                <p>Affecter un livreur pour la commande <strong>{{ commande.numeroCommande }}</strong></p>
                                                <div class="mb-3">
                                                    <label for="livreurSelect{{ commande.id }}" class="form-label">Sélectionner un livreur</label>
                                                    <select id="livreurSelect{{ commande.id }}" class="form-select livreur-select">
                                                        <option value="">-- Choisir un livreur --</option>
                                                        {% for livreur in livreurs_disponibles %}
                                                        <option value="{{ livreur.id }}">{{ livreur }} ({{ livreur.telephone }})</option>
                                                        {% endfor %}
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                                                <button type="button" 
                                                        class="btn btn-primary affecter-livreur-btn" 
                                                        data-commande-id="{{ commande.id }}">
                                                    Affecter
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                {% endif %}
                                
                                {% else %}
                                <tr>
                                    <td colspan="7" class="text-center">
                                        <div class="empty-state py-5">
                                            <i class="bi bi-cart"></i>
                                            <p>Aucune commande trouvée</p>
                                        </div>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Gestion de l'affectation des livreurs
    document.querySelectorAll('.affecter-livreur-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            const commandeId = this.dataset.commandeId;
            const select = document.getElementById('livreurSelect' + commandeId);
            const livreurId = select.value;
            
            if (!livreurId) {
                alert('Veuillez sélectionner un livreur');
                return;
            }
            
            // Envoyer la requête AJAX
            fetch('/gestionnaire/commande/' + commandeId + '/affecter-livreur', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify({ livreur_id: livreurId })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert(data.message);
                    location.reload();
                } else {
                    alert(data.message);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Erreur lors de l\'affectation du livreur');
            });
        });
    });
});
</script>
{% endblock %}