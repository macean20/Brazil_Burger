{# templates/gestionnaire/livraison/zone/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Zones de Livraison - Brasil Burger{% endblock %}

{% block body %}
<div id="dashboardPage">
    {% include 'components/_navbar.html.twig' %}
    
    <div class="container-fluid mt-4">
        {% include 'components/_toast.html.twig' %}
        
        <ul class="nav nav-tabs">
            <li class="nav-item">
                <a href="{{ path('gestionnaire_dashboard') }}" class="nav-link">
                    <i class="bi bi-speedometer2"></i> Tableau de bord
                </a>
            </li>
            <li class="nav-item">
                <a href="{{ path('gestionnaire_commande_index') }}" class="nav-link">
                    <i class="bi bi-cart"></i> Commandes
                </a>
            </li>
            <li class="nav-item">
                <a href="{{ path('gestionnaire_zone_index') }}" class="nav-link active">
                    <i class="bi bi-truck"></i> Zones de livraison
                </a>
            </li>
            <li class="nav-item">
                <a href="{{ path('gestionnaire_livreur_index') }}" class="nav-link">
                    <i class="bi bi-person-badge"></i> Livreurs
                </a>
            </li>
        </ul>
        
        <div class="p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>Gestion des Zones de Livraison</h2>
                <a href="{{ path('gestionnaire_zone_new') }}" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> Ajouter une zone
                </a>
            </div>
            
            {% if zones|length > 0 %}
            <div class="row g-4">
                {% for zone in zones %}
                <div class="col-md-4">
                    <div class="card zone-card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h5 class="card-title mb-1">{{ zone.nom }}</h5>
                                    <p class="text-muted mb-0">
                                        {{ zone.quartiers|length }} quartier{{ zone.quartiers|length > 1 ? 's' : '' }}
                                    </p>
                                </div>
                                <span class="badge bg-primary">
                                    {{ zone.prixLivraison|number_format(0, '.', ' ') ~ ' XOF' }}
                                </span>
                            </div>
                            
                            {% if zone.description %}
                            <p class="card-text small">{{ zone.description }}</p>
                            {% endif %}
                            
                            <div class="mt-3">
                                <h6 class="small text-uppercase text-muted mb-2">Quartiers</h6>
                                <div class="d-flex flex-wrap gap-1">
                                    {% for quartier in zone.quartiers|slice(0, 5) %}
                                    <span class="badge bg-light text-dark border">
                                        {{ quartier.nom }}
                                    </span>
                                    {% endfor %}
                                    {% if zone.quartiers|length > 5 %}
                                    <span class="badge bg-light text-dark border">
                                        +{{ zone.quartiers|length - 5 }} autres
                                    </span>
                                    {% endif %}
                                </div>
                            </div>
                            
                            <div class="mt-4 d-flex justify-content-between">
                                <a href="{{ path('gestionnaire_zone_edit', {'id': zone.id}) }}" 
                                   class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-pencil"></i> Modifier
                                </a>
                                
                                <form method="post" 
                                      action="{{ path('gestionnaire_zone_delete', {'id': zone.id}) }}"
                                      onsubmit="return confirm('Supprimer cette zone ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ zone.id) }}">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i> Supprimer
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
            {% else %}
            <div class="empty-state text-center py-5">
                <i class="bi bi-geo-alt" style="font-size: 4rem;"></i>
                <h4 class="mt-3">Aucune zone de livraison</h4>
                <p class="text-muted">Commencez par créer votre première zone de livraison</p>
                <a href="{{ path('gestionnaire_zone_new') }}" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> Créer une zone
                </a>
            </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}