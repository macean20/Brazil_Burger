{% extends 'base.html.twig' %}

{% block title %}{% if livreur.id %}Modifier{% else %}Ajouter{% endif %} un livreur - Brasil Burger{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>
            <i class="bi bi-person-badge"></i> 
            {% if livreur.id %}
                Modifier le livreur
            {% else %}
                Ajouter un livreur
            {% endif %}
        </h2>
        <a href="{{ path('gestionnaire_livreur_index') }}" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Retour
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-body">
                    {{ form_start(form) }}
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            {{ form_row(form.nom) }}
                        </div>
                        <div class="col-md-6 mb-3">
                            {{ form_row(form.prenom) }}
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            {{ form_row(form.telephone) }}
                        </div>
                        <div class="col-md-6 mb-3">
                            {{ form_row(form.email) }}
                        </div>
                    </div>

                    <div class="mb-3">
                        {{ form_row(form.plainPassword, {
                            'help': 'Laissez vide pour conserver le mot de passe actuel (en cas de modification)'
                        }) }}
                    </div>

                    <div class="mb-3">
                        <div class="form-check">
                            {{ form_widget(form.disponible) }}
                            {{ form_label(form.disponible) }}
                        </div>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a href="{{ path('gestionnaire_livreur_index') }}" class="btn btn-secondary">
                            <i class="bi bi-x-circle"></i> Annuler
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle"></i> 
                            {% if livreur.id %}Modifier{% else %}Créer{% endif %}
                        </button>
                    </div>

                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}