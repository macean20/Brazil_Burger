{% extends 'base.html.twig' %}

{% block title %}{% if burger.id %}Modifier{% else %}Ajouter{% endif %} un burger{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-bag"></i> {% if burger.id %}Modifier{% else %}Ajouter{% endif %} un burger</h2>
        <a href="{{ path('gestionnaire_burger_index') }}" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Retour
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-body">
                    {{ form_start(form) }}
                    
                    <div class="mb-3">
                        {{ form_row(form.nom) }}
                    </div>

                    <div class="mb-3">
                        {{ form_row(form.description) }}
                    </div>

                    <div class="mb-3">
                        {{ form_row(form.prix) }}
                    </div>

                    <div class="mb-3">
                        {{ form_row(form.imageFile, {
                            'label': 'Image'
                        }) }}
                        {% if burger.imageUrl %}
                            <div class="mt-2">
                                <img src="{{ burger.imageUrl }}" alt="{{ burger.nom }}" class="img-thumbnail" style="max-width: 200px;">
                            </div>
                        {% endif %}
                    </div>

                    <div class="mb-3">
                        <div class="form-check">
                            {{ form_widget(form.disponible) }}
                            {{ form_label(form.disponible) }}
                        </div>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a href="{{ path('gestionnaire_burger_index') }}" class="btn btn-secondary">
                            <i class="bi bi-x-circle"></i> Annuler
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle"></i> {% if burger.id %}Modifier{% else %}Créer{% endif %}
                        </button>
                    </div>

                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}