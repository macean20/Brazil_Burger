{# templates/gestionnaire/burger/_form.html.twig #}
{{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}
    <div class="row">
        <div class="col-md-8">
            <div class="mb-3">
                {{ form_label(form.nom) }}
                {{ form_widget(form.nom, {'attr': {'class': 'form-control'}}) }}
                <div class="invalid-feedback">
                    {{ form_errors(form.nom) }}
                </div>
            </div>
            
            <div class="mb-3">
                {{ form_label(form.description) }}
                {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': 4}}) }}
            </div>
            
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        {{ form_label(form.prix) }}
                        {{ form_widget(form.prix, {'attr': {'class': 'form-control'}}) }}
                        <div class="invalid-feedback">
                            {{ form_errors(form.prix) }}
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        {{ form_label(form.disponible) }}
                        <div class="form-check form-switch mt-2">
                            {{ form_widget(form.disponible, {'attr': {'class': 'form-check-input'}}) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="mb-3">
                {{ form_label(form.imageFile) }}
                
                {% if burger.imageUrl %}
                <div class="mb-3">
                    <img src="{{ burger.imageUrl }}" 
                         alt="{{ burger.nom }}" 
                         class="img-thumbnail mb-2" 
                         style="max-height: 200px;">
                    <div class="form-text">
                        Image actuelle. Téléchargez une nouvelle image pour la remplacer.
                    </div>
                </div>
                {% endif %}
                
                <div class="file-upload-area" id="imageUploadArea">
                    <i class="bi bi-cloud-arrow-up"></i>
                    <p class="mb-2">Glissez-déposez ou cliquez pour télécharger</p>
                    <p class="small text-muted">JPEG, PNG, WebP (max 2MB)</p>
                    {{ form_widget(form.imageFile, {'attr': {'class': 'd-none', 'id': 'imageFileInput'}}) }}
                </div>
                <div class="invalid-feedback">
                    {{ form_errors(form.imageFile) }}
                </div>
            </div>
        </div>
    </div>
    
    <div class="d-flex justify-content-between mt-4">
        <a href="{{ path('gestionnaire_burger_index') }}" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Retour
        </a>
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-save"></i> {{ burger.id ? 'Modifier' : 'Créer' }}
        </button>
    </div>
{{ form_end(form) }}

<script>
document.addEventListener('DOMContentLoaded', function() {
    const imageUploadArea = document.getElementById('imageUploadArea');
    const imageFileInput = document.getElementById('imageFileInput');
    
    if (imageUploadArea && imageFileInput) {
        // Cliquer sur la zone déclenche l'input file
        imageUploadArea.addEventListener('click', function() {
            imageFileInput.click();
        });
        
        // Changement de fichier
        imageFileInput.addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                // Afficher le nom du fichier
                imageUploadArea.innerHTML = `
                    <i class="bi bi-check-circle text-success"></i>
                    <p class="mb-2">${file.name}</p>
                    <p class="small text-muted">${(file.size / 1024).toFixed(0)} KB</p>
                `;
                
                // Prévisualisation
                const reader = new FileReader();
                reader.onload = function(e) {
                    const preview = document.createElement('img');
                    preview.src = e.target.result;
                    preview.className = 'img-thumbnail mt-2';
                    preview.style.maxHeight = '150px';
                    imageUploadArea.appendChild(preview);
                };
                reader.readAsDataURL(file);
            }
        });
        
        // Drag and drop
        ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
            imageUploadArea.addEventListener(eventName, preventDefaults, false);
        });
        
        function preventDefaults(e) {
            e.preventDefault();
            e.stopPropagation();
        }
        
        ['dragenter', 'dragover'].forEach(eventName => {
            imageUploadArea.addEventListener(eventName, highlight, false);
        });
        
        ['dragleave', 'drop'].forEach(eventName => {
            imageUploadArea.addEventListener(eventName, unhighlight, false);
        });
        
        function highlight() {
            imageUploadArea.classList.add('border-primary');
        }
        
        function unhighlight() {
            imageUploadArea.classList.remove('border-primary');
        }
        
        imageUploadArea.addEventListener('drop', handleDrop, false);
        
        function handleDrop(e) {
            const dt = e.dataTransfer;
            const files = dt.files;
            imageFileInput.files = files;
            imageFileInput.dispatchEvent(new Event('change'));
        }
    }
    
    // Validation du formulaire
    const form = document.querySelector('form');
    if (form) {
        form.addEventListener('submit', function(event) {
            if (!form.checkValidity()) {
                event.preventDefault();
                event.stopPropagation();
            }
            form.classList.add('was-validated');
        }, false);
    }
});
</script>