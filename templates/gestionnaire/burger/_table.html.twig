{# templates/gestionnaire/burger/_table.html.twig #}
<div class="table-responsive">
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Image</th>
                <th>Nom</th>
                <th>Description</th>
                <th>Prix</th>
                <th>Statut</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for burger in burgers %}
            <tr>
                <td>
                    {% if burger.imageUrl %}
                        <img src="{{ burger.imageUrl }}" 
                             alt="{{ burger.nom }}" 
                             class="product-image"
                             data-bs-toggle="modal" 
                             data-bs-target="#imageModal{{ burger.id }}">
                    {% else %}
                        <div class="product-image bg-light d-flex align-items-center justify-content-center">
                            <i class="bi bi-image text-muted"></i>
                        </div>
                    {% endif %}
                </td>
                <td>
                    <strong>{{ burger.nom }}</strong>
                    <br>
                    <small class="text-muted">Créé le {{ burger.createdAt|date('d/m/Y') }}</small>
                </td>
                <td>
                    {{ burger.description|slice(0, 80) }}
                    {% if burger.description|length > 80 %}...{% endif %}
                </td>
                <td>
                    <span class="price-display">{{ burger.prix|number_format(0, '.', ' ') ~ ' XOF' }}</span>
                </td>
                <td>
                    <span class="badge {{ burger.disponible ? 'bg-success' : 'bg-danger' }}">
                        {{ burger.disponible ? 'Disponible' : 'Indisponible' }}
                    </span>
                </td>
                <td>
                    <div class="action-icons">
                        <a href="{{ path('gestionnaire_burger_edit', {'id': burger.id}) }}" 
                           class="btn btn-sm btn-outline-primary"
                           title="Modifier">
                            <i class="bi bi-pencil"></i>
                        </a>
                        
                        <form method="post" 
                              action="{{ path('gestionnaire_burger_toggle_disponibilite', {'id': burger.id}) }}" 
                              class="d-inline">
                            <button type="submit" 
                                    class="btn btn-sm {{ burger.disponible ? 'btn-warning' : 'btn-success' }}"
                                    title="{{ burger.disponible ? 'Rendre indisponible' : 'Rendre disponible' }}">
                                <i class="bi {{ burger.disponible ? 'bi-eye-slash' : 'bi-eye' }}"></i>
                            </button>
                        </form>
                        
                        <button type="button" 
                                class="btn btn-sm btn-outline-danger"
                                data-bs-toggle="modal" 
                                data-bs-target="#deleteModal{{ burger.id }}"
                                title="Supprimer">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </td>
            </tr>

            {# Modal pour afficher l'image en grand #}
            <div class="modal fade" id="imageModal{{ burger.id }}" tabindex="-1">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">{{ burger.nom }}</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body text-center">
                            {% if burger.imageUrl %}
                                <img src="{{ burger.imageUrl }}" 
                                     alt="{{ burger.nom }}" 
                                     class="img-fluid rounded">
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>

            {# Modal de confirmation de suppression #}
            <div class="modal fade" id="deleteModal{{ burger.id }}" tabindex="-1">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Confirmer la suppression</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            Êtes-vous sûr de vouloir supprimer le burger <strong>"{{ burger.nom }}"</strong> ?
                            <div class="alert alert-warning mt-2">
                                <i class="bi bi-exclamation-triangle"></i>
                                Cette action est irréversible.
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                            <form method="post" 
                                  action="{{ path('gestionnaire_burger_delete', {'id': burger.id}) }}" 
                                  class="d-inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ burger.id) }}">
                                <button type="submit" class="btn btn-danger">Supprimer</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
            {% else %}
            <tr>
                <td colspan="6" class="text-center py-5">
                    <div class="empty-state">
                        <i class="bi bi-bag"></i>
                        <h5 class="mt-3">Aucun burger trouvé</h5>
                        <p class="text-muted">Commencez par créer votre premier burger</p>
                    </div>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>