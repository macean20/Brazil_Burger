{% extends 'base.html.twig' %}

{% block title %}Gestion des Menus{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-menu-button-wide"></i> Gestion des Menus</h2>
        <a href="{{ path('gestionnaire_menu_new') }}" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Ajouter un menu
        </a>
    </div>

    <div class="card">
        <div class="card-body">
            {% if menus is empty %}
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-inbox" style="font-size: 4rem;"></i>
                    <p class="mt-3">Aucun menu pour le moment</p>
                </div>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Nom</th>
                                <th>Composition</th>
                                <th>Prix</th>
                                <th>Statut</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for menu in menus %}
                                <tr>
                                    <td><strong>{{ menu.nom }}</strong></td>
                                    <td>
                                        <small>
                                            {{ menu.burger.nom }}<br>
                                            {{ menu.boisson.nom }}<br>
                                            {{ menu.frite.nom }}
                                        </small>
                                    </td>
                                    <td><strong>{{ menu.prixTotal|number_format(0, ',', ' ') }} FCFA</strong></td>
                                    <td>
                                        {% if menu.disponible %}
                                            <span class="badge bg-success">Disponible</span>
                                        {% else %}
                                            <span class="badge bg-secondary">Indisponible</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <a href="{{ path('gestionnaire_menu_edit', {'id': menu.id}) }}" class="btn btn-sm btn-warning">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form method="post" action="{{ path('gestionnaire_menu_delete', {'id': menu.id}) }}" style="display:inline;" onsubmit="return confirm('Supprimer ce menu ?');">
                                            <button type="submit" class="btn btn-sm btn-danger">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}