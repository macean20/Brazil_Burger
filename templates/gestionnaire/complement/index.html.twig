{% extends 'base.html.twig' %}

{% block title %}Gestion des Compléments{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-cup-straw"></i> Gestion des Compléments</h2>
        <a href="{{ path('gestionnaire_complement_new') }}" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Ajouter un complément
        </a>
    </div>

    <div class="card">
        <div class="card-body">
            {% if complements is empty %}
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-inbox" style="font-size: 4rem;"></i>
                    <p class="mt-3">Aucun complément pour le moment</p>
                </div>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Nom</th>
                                <th>Type</th>
                                <th>Prix</th>
                                <th>Statut</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for complement in complements %}
                                <tr>
                                    <td><strong>{{ complement.nom }}</strong></td>
                                    <td>
                                        {% if complement.type == 'BOISSON' %}
                                            <span class="badge bg-info">Boisson</span>
                                        {% else %}
                                            <span class="badge bg-warning">Frite</span>
                                        {% endif %}
                                    </td>
                                    <td><strong>{{ complement.prix|number_format(0, ',', ' ') }} FCFA</strong></td>
                                    <td>
                                        {% if complement.disponible %}
                                            <span class="badge bg-success">Disponible</span>
                                        {% else %}
                                            <span class="badge bg-secondary">Indisponible</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <a href="{{ path('gestionnaire_complement_edit', {'id': complement.id}) }}" class="btn btn-sm btn-warning">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form method="post" action="{{ path('gestionnaire_complement_delete', {'id': complement.id}) }}" style="display:inline;" onsubmit="return confirm('Supprimer ce complément ?');">
                                            <button type="submit" class="btn btn-sm btn-danger">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}